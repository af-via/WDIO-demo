{
  "name": "wdio-mobile-framework",
  "version": "1.0.0",
  "description": "WebdriverIO + Appium mobile testing framework with XCUITest, UIAutomator2, Allure reports, Firebase & TestMu integration",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test:android:local": "wdio run config/wdio.android.local.conf.ts",
    "test:ios:local": "wdio run config/wdio.ios.local.conf.ts",
    "test:android:testmu": "wdio run config/wdio.testmu.android.conf.ts",
    "test:ios:testmu": "wdio run config/wdio.testmu.ios.conf.ts",
    "allure:generate": "pnpm dlx allure-commandline generate allure-results --clean -o allure-report",
    "allure:open": "pnpm dlx allure-commandline open allure-report",
    "allure:report": "pnpm run allure:generate && pnpm run allure:open",
    "prepare:apps": "ts-node scripts/prepareApps.ts",
    "download:firebase:android": "ts-node scripts/downloadFromFirebase.ts --platform android",
    "download:firebase:ios": "ts-node scripts/downloadFromFirebase.ts --platform ios",
    "upload:testmu:android": "ts-node scripts/uploadToTestMu.ts --platform android",
    "upload:testmu:ios": "ts-node scripts/uploadToTestMu.ts --platform ios",
    "ci:android": "pnpm run prepare:apps -- --platform android && pnpm run test:android:testmu",
    "ci:ios": "pnpm run prepare:apps -- --platform ios && pnpm run test:ios:testmu",
    "appium:install:drivers": "pnpm dlx appium driver install xcuitest && pnpm dlx appium driver install uiautomator2",
    "lint": "eslint src tests config scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.14.2",
    "form-data": "^4.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/mocha": "^10.0.7",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "@wdio/types": "^9.0.0",
    "eslint": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
