# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────

# ── Execution Target ──────────────────────────────────────────
# Values: local | testmu
TEST_TARGET=local

# ── TestMu / LambdaTest ───────────────────────────────────────
LT_USERNAME=your_lt_username
LT_ACCESS_KEY=your_lt_access_key

# App URLs returned after upload (set automatically by scripts/uploadToTestMu.ts)
TESTMU_APP_URL_ANDROID=lt://APP_XXXXXXXXXX
TESTMU_APP_URL_IOS=lt://APP_YYYYYYYYYY

# TestMu real device selection
TESTMU_ANDROID_DEVICE=Pixel 8
TESTMU_ANDROID_VERSION=14
TESTMU_IOS_DEVICE=iPhone 15
TESTMU_IOS_VERSION=17

# ── Firebase App Distribution ─────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_APP_ID_ANDROID=1:123456789:android:abcdef12345678
FIREBASE_APP_ID_IOS=1:123456789:ios:abcdef12345678
# Path to the GCP service account JSON file (relative to project root)
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json

# ── Local App Paths (used when TEST_TARGET=local) ─────────────
APP_PATH_ANDROID=./apps/android/app.apk
APP_PATH_IOS=./apps/ios/app.ipa

# ── Local Device / Emulator ────────────────────────────────────
# Android emulator (use `adb devices` to find your device name)
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=14.0
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=com.example.app.MainActivity

# iOS simulator / real device (use `xcrun simctl list` to find simulator)
IOS_DEVICE_NAME=iPhone 15
IOS_PLATFORM_VERSION=17.4
IOS_UDID=
IOS_BUNDLE_ID=com.example.app

# ── Test Data ──────────────────────────────────────────────────
TEST_USERNAME=testuser@example.com
TEST_PASSWORD=Password123!

# ── Build Metadata ─────────────────────────────────────────────
BUILD_NAME=Local Development
BUILD_NUMBER=0
SUITE_NAME=Mobile Regression

# ── Timeouts (ms) ──────────────────────────────────────────────
IMPLICIT_TIMEOUT=10000
EXPLICIT_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=60000

# ── Logging ────────────────────────────────────────────────────
# Values: error | warn | info | debug
LOG_LEVEL=info
